{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "paths": {
      "@wave-atlas/api/router": [
        "./apps/api/src/routerType.ts"
      ],
      "@wave-atlas/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "server/*": [
        "./apps/api/src/*"
      ],
      "views/*": [
        "./apps/web/src/views/*"
      ],
      "widgets/*": [
        "./apps/web/src/widgets/*"
      ],
      "features/*": [
        "./apps/web/src/features/*"
      ],
      "entities/*": [
        "./apps/web/src/entities/*"
      ],
      "shared/*": [
        "./apps/web/src/shared/*"
      ],
      "test/*": [
        "./apps/web/src/test/*",
        "./src/test/*"
      ],
      "types/*": [
        "./apps/web/src/types/*"
      ],
      "*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "apps/web/src",
    "packages/contracts/src",
    "vitest.d.ts",
    "tests",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
