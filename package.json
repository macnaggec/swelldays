{
  "name": "swelldays",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "overrides": {
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm run dev:client\" \"npm run dev:server\"",
    "dev:https": "DEV_HTTPS=true npm run dev",
    "dev:client": "vite",
    "dev:server": "npm run dev --workspace @wave-atlas/api",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "npm run typecheck --workspace @wave-atlas/api && esbuild apps/api/src/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=apps/api/tsconfig.json --outfile=dist/server/index.js",
    "start": "npm run start:server",
    "start:server": "node dist/server/index.js",
    "test": "vitest",
    "test:client": "vitest --project client",
    "test:server": "vitest --project server",
    "test:integration": "vitest --project integration",
    "lint": "eslint apps/api/src src packages/contracts/src tests playwright.config.ts playwright.layout.config.ts",
    "check:style-boundaries": "node scripts/check-style-boundaries.mjs",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:visual": "node --env-file=.env.capture node_modules/@playwright/test/cli.js test",
    "test:layout": "playwright test --config=playwright.layout.config.ts",
    "capture:db:up": "docker compose -f docker-compose.capture.yml up -d --wait",
    "capture:db:down": "docker compose -f docker-compose.capture.yml down",
    "capture:seed": "node --env-file=.env.capture node_modules/prisma/build/index.js migrate deploy && node --env-file=.env.capture --import tsx tests/visual/seed.ts"
  },
  "dependencies": {
    "@wave-atlas/contracts": "*",
    "@fontsource/geist-sans": "^5.2.5",
    "@hono/node-server": "^1.13.7",
    "@hono/trpc-server": "^0.4.2",
    "@mantine/carousel": "^8.3.11",
    "@mantine/core": "^8.3.1",
    "@mantine/dates": "^8.3.11",
    "@mantine/dropzone": "^8.3.11",
    "@mantine/hooks": "^8.3.1",
    "@mantine/notifications": "^8.3.11",
    "@mantine/nprogress": "^8.3.11",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tabler/icons-react": "^3.12.0",
    "@tanstack/react-query": "^5.95.0",
    "@tanstack/react-query-devtools": "^5.95.0",
    "@tanstack/react-router": "^1.166.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@tanstack/router-devtools": "^1.166.0",
    "@tanstack/router-plugin": "^1.166.0",
    "@trpc/client": "^11.15.0",
    "@trpc/react-query": "^11.15.0",
    "@trpc/server": "^11.15.0",
    "@trpc/tanstack-react-query": "^11.15.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.0",
    "cloudinary": "^2.4.0",
    "compose-function": "^3.0.3",
    "dayjs": "^1.11.19",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "exifr": "^7.1.3",
    "framer-motion": "^12.40.0",
    "hls.js": "^1.5.15",
    "hono": "^4.7.7",
    "mapbox-gl": "^3.9.4",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^7.1.9",
    "superjson": "^2.2.6",
    "uuid": "^13.0.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@wave-atlas/api": "*",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compose-function": "^0.0.33",
    "@types/node": "20.19.0",
    "@types/pg": "^8.16.0",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "chrome-remote-interface": "^0.34.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.41",
    "postcss-loader": "^8.1.1",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.17",
    "vitest-mock-extended": "^3.1.0"
  }
}
