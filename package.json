{
  "name": "swelldays",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "overrides": {
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm run dev:client\" \"npm run dev:server\"",
    "dev:https": "DEV_HTTPS=true npm run dev",
    "dev:client": "npm run dev --workspace @swelldays/web --",
    "dev:server": "npm run dev --workspace @swelldays/api",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run build --workspace @swelldays/web",
    "build:server": "npm run build --workspace @swelldays/api",
    "start": "npm run start:server",
    "start:server": "npm run start --workspace @swelldays/api",
    "test": "vitest",
    "test:client": "vitest --project client",
    "test:server": "vitest --project server",
    "test:scripts": "vitest run --project scripts",
    "test:integration": "vitest --project integration",
    "lint": "eslint apps/api/src apps/api/prisma.config.ts apps/web/src apps/web/scripts apps/web/vite.config.ts packages/contracts/src tests playwright.config.ts playwright.layout.config.ts",
    "check:style-boundaries": "node scripts/check-style-boundaries.mjs",
    "prisma:generate": "npm run prisma:generate --workspace @swelldays/api",
    "prisma:validate": "npm run prisma:validate --workspace @swelldays/api",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @swelldays/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @swelldays/api",
    "prisma:migrate:status": "npm run prisma:migrate:status --workspace @swelldays/api",
    "prisma:studio": "npm run prisma:studio --workspace @swelldays/api",
    "prisma:seed": "npm run prisma:seed --workspace @swelldays/api",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:visual": "node --env-file=.env.capture node_modules/@playwright/test/cli.js test",
    "test:layout": "playwright test --config=playwright.layout.config.ts",
    "capture:db:up": "docker compose -f docker-compose.capture.yml up -d --wait",
    "capture:db:down": "docker compose -f docker-compose.capture.yml down",
    "capture:seed": "node --env-file=.env.capture node_modules/prisma/build/index.js migrate deploy --config apps/api/prisma.config.ts && node --env-file=.env.capture --import tsx tests/visual/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@prisma/client": "^7.9.1",
    "@types/node": "20.19.0",
    "@vitejs/plugin-react": "^5.1.2",
    "chrome-remote-interface": "^0.34.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.4.0",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.0.17"
  }
}
