# Public API origin embedded in the frontend production bundle
VITE_API_URL="http://localhost:3001"

# Google OAuth (browser)
VITE_GOOGLE_CLIENT_ID=""
# Google Picker API (Google Cloud Platform API Key — restrict to "Google Picker API")
# Create at: Google Cloud Console → APIs & Services → Credentials → Create Credentials → API Key
VITE_GOOGLE_API_KEY=

# Mapbox
# Get your access token at https://account.mapbox.com/access-tokens/
# NOTE: this token is exposed to browser clients. Restrict it in Mapbox to your production/staging domains.
VITE_MAPBOX_ACCESS_TOKEN="your-mapbox-token-here"

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_API_KEY=""

# Error tracking — optional, leave blank to disable. Not a secret (Sentry
# DSNs are designed to be embedded in client-side code).
VITE_SENTRY_DSN=""

# Paddle — only used when the API's PAYMENT_PROVIDER=paddle. The client-side
# token is public by design (Developer Tools -> Authentication -> Client-side
# tokens in the Paddle dashboard), separate from the API's own secret key.
VITE_PADDLE_CLIENT_TOKEN=""
VITE_PADDLE_ENVIRONMENT=""
