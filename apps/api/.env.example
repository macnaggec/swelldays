# Database
DATABASE_URL="postgresql://user:password@localhost:5432/surfdb"

# API runtime
NODE_ENV="development"
FRONTEND_ORIGIN="http://localhost:3000"
SERVER_PORT="3001"

# Better Auth
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters-in-production"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment provider — 'mock', 'cryptocloud', or 'paddle'.
# Use 'mock' to skip a real payment gateway entirely during local development.
# CryptoCloud credentials documented in .env.payments.cryptocloud
# Paddle credentials documented in .env.payments.paddle
# Defaults to live when NODE_ENV=production; otherwise test.
# Production staging must explicitly opt into COMMERCE_MODE=test.
# Live rollout fails until matching public declarations and live credentials exist.
COMMERCE_MODE=test
PAYMENT_PROVIDER=mock
# Inject the SAME public payment declarations used for the web build into API runtime.
VITE_COMMERCE_MODE=test
VITE_PAYMENT_PROVIDER=mock
VITE_PADDLE_CLIENT_TOKEN=""
VITE_PADDLE_ENVIRONMENT=""
# Live CryptoCloud requires all three credentials below, with no placeholders.
# Live Paddle requires PADDLE_ENVIRONMENT=production, pdl_live_apikey_ API key,
# a non-placeholder webhook secret, and a live_ public client token.
# Sandbox API keys use pdl_sdbx_apikey_; public sandbox tokens use test_.
# https://developer.paddle.com/api-reference/about/authentication/
# https://developer.paddle.com/paddle-js/about/client-side-tokens/
CRYPTOCLOUD_API_KEY=""
CRYPTOCLOUD_SHOP_ID=""
CRYPTOCLOUD_SECRET_KEY=""
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_ENVIRONMENT=""

# Error tracking — optional, leave blank to disable
SENTRY_DSN=""
