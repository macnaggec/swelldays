# Database
DATABASE_URL="postgresql://user:password@localhost:5432/surfdb"

# API runtime
NODE_ENV="development"
FRONTEND_ORIGIN="http://localhost:3000"
SERVER_PORT="3001"

# Better Auth
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters-in-production"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment provider (CryptoCloud) — credentials documented in .env.payments.cryptocloud
# Use 'mock' to skip CryptoCloud entirely during local development
PAYMENT_PROVIDER=mock
CRYPTOCLOUD_API_KEY=""
CRYPTOCLOUD_SHOP_ID=""
CRYPTOCLOUD_SECRET_KEY=""

# Error tracking — optional, leave blank to disable
SENTRY_DSN=""
