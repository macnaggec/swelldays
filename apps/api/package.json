{
  "name": "@wave-atlas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/routerType.ts"
    }
  },
  "scripts": {
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --alias:@wave-atlas/contracts=../../packages/contracts/src/index.ts --outfile=dist/index.js",
    "dev": "DOTENV_CONFIG_PATH=.env.development tsx watch src/index.ts",
    "prisma:generate": "DOTENV_CONFIG_PATH=.env.development prisma generate --config prisma.config.ts",
    "prisma:validate": "DOTENV_CONFIG_PATH=.env.development prisma validate --config prisma.config.ts",
    "prisma:migrate:dev": "DOTENV_CONFIG_PATH=.env.development prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "DOTENV_CONFIG_PATH=.env.production prisma migrate deploy --config prisma.config.ts",
    "prisma:migrate:status": "DOTENV_CONFIG_PATH=.env.development prisma migrate status --config prisma.config.ts",
    "prisma:studio": "DOTENV_CONFIG_PATH=.env.development prisma studio --config prisma.config.ts",
    "prisma:seed": "DOTENV_CONFIG_PATH=.env.development prisma db seed --config prisma.config.ts",
    "start": "DOTENV_CONFIG_PATH=.env.production node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/trpc-server": "^0.4.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@trpc/server": "^11.15.0",
    "@wave-atlas/contracts": "*",
    "better-auth": "1.7.0",
    "cloudinary": "^2.4.0",
    "dotenv": "^17.4.2",
    "hono": "^4.7.7",
    "pg": "^8.16.3",
    "superjson": "^2.2.6",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "@types/pg": "^8.16.0",
    "esbuild": "^0.28.2",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "vitest-mock-extended": "^3.1.0"
  }
}
