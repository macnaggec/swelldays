{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@wave-atlas/contracts": ["../../packages/contracts/src/index.ts"],
      "server/*": ["src/*"],
      "test/*": ["../../src/test/*"]
    }
  },
  "include": [
    "src",
    "prisma.config.ts",
    "../../packages/contracts/src",
    "../../src/test/helpers/resetDb.ts"
  ]
}
