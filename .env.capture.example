# Environment for the visual-regression capture run (roadmap F12h).
# Copy to .env.capture — which is gitignored — and fill in the credentials.
#
# Only DATABASE_URL differs from ordinary dev: it points at the dedicated
# capture database from docker-compose.capture.yml, so baselines never depend on
# records you edit while working in the app.

DATABASE_URL="postgresql://capture:capture@localhost:5434/surfdb_capture"

# Credentials for the capture account. The seed creates this account and the
# Playwright setup project signs in with it. Any values work — they only ever
# exist in the throwaway capture database.
REFERENCE_EMAIL="capture@example.com"
REFERENCE_PASSWORD="capture-password"

# better-auth refuses to start without a secret. Any value works here.
BETTER_AUTH_SECRET="capture-only-secret"

# Client-side config. VITE_MAPBOX_ACCESS_TOKEN must be a real token: the map
# component throws when it is missing, and the canvas is masked in every
# screenshot anyway, so the map's own rendering never reaches a baseline.
VITE_MAPBOX_ACCESS_TOKEN=""
VITE_CLOUDINARY_CLOUD_NAME="capture-cloud"
