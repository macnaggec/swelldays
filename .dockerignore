# Ignore everything
**

# Package metadata
!package.json
!package-lock.json
!.npmrc

# TypeScript config
!tsconfig.json
!tsconfig.base.json
!tsconfig.server.json
!vitest.d.ts

# Workspaces (including API-owned Prisma and shared contracts)
!apps/
!apps/**
apps/**/dist/
apps/**/node_modules/
!packages/
!packages/**

# Real env files now live inside apps/api and apps/web (split from root) —
# never ship secrets into a build context or image layer.
apps/api/.env
apps/api/.env.*
apps/web/.env
apps/web/.env.*
